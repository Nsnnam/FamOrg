# FamOrg environment template
# Copy to .env and fill in values for your own host. Do not commit .env.

# Host ports
LOCAL_PORT=3000
PUBLIC_PORT=8443

# Optional prebuilt image published by your fork
IMAGE=ghcr.io/your-github-user/famorg:latest

# Optional AI and web-push settings
GEMINI_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Public URL used for deep links; use your own domain or leave local-only.
APP_URL=http://localhost:3000

# Watchtower API token
WATCHTOWER_HTTP_API_TOKEN=change_me_to_a_random_secret

# Repository used by the update checker
GITHUB_REPO=your-github-user/FamOrg

# Optional nginx server name when using the bundled HTTPS terminator
SERVER_NAME=_
